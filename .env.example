# Nunca coloque valores reais neste ficheiro. Copie-o para .env.local apenas
# para desenvolvimento local, ou configure os valores no ambiente do provedor.

# Vercel API routes (server-only)
SUPABASE_URL=
# Prefer the modern secret key. The legacy name is accepted temporarily by
# the server code only to make the credential rotation non-disruptive.
SUPABASE_SECRET_KEY=
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=

# Supabase Edge Functions (server-only)
# CREEM_API_KEY=
# CREEM_WEBHOOK_SECRET=
# SITE_URL=

# A aplicação estática usa uma chave Supabase publicável no browser. Ela não é
# segredo e só é segura juntamente com RLS; nunca use uma chave de serviço aqui.
# SUPABASE_PUBLISHABLE_KEY=
